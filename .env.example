# Template for the .env file this project reads from the repository root.
#
# Copy to .env and fill in the values:
#     cp .env.example .env          (macOS/Linux)
#     copy .env.example .env        (Windows)
#
# .env is gitignored and must never be committed. This file is committed on
# purpose, so the repository documents what credentials are needed without
# containing any.
#
# Nothing in the local pipeline needs these. run_pipeline.py, the evaluation,
# the tests and the dashboard all run without a .env at all; the dashboard
# falls back to reading data/scores/scores.csv. These are only required for
# the Snowflake path.

# --- Snowflake (required for the warehouse path) ---------------------------
# SNOW_ACCOUNT is the account identifier, e.g. ORGNAME-ACCOUNTNAME. It is the
# part before .snowflakecomputing.com in your account URL.
SNOW_ACCOUNT=
SNOW_USER=
SNOW_PWD=
SNOW_DATABASE=
SNOW_SCHEMA=
SNOW_WAREHOUSE=
SNOW_ROLE=

# --- Slack alerting (optional) ---------------------------------------------
# Read by models/check_fraud_alerts.py. Leave blank to skip alerting; the
# script is not part of the local pipeline.
SLACK_WEBHOOK_URL=
FRAUD_ALERT_THRESHOLD=1
